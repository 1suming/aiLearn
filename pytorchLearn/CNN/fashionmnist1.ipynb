    "import torch\n",
    "from torch import nn\n",
    "\n",
    "X=torch.randn(32,1,28,28)\n",
    "print(X.shape)\n",
    "\n",
    "conv=nn.Conv2d(\n",
    "    in_channels=1,\n",
    "    out_channels=8,\n",
    "    kernel_size=3,\n",
    "    padding=1,\n",
    ")\n",
    "\n",
    "output=conv(X)\n",
    "print(output.shape)"
   ]
  }
